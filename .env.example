# Copy to .env and fill in real values. Never commit .env.

# HTTP port (default 3000)
PORT=3000

# SQLite database path (default data/ticketing.db)
# DB_PATH=data/ticketing.db

# Secret for login JWTs (required in production)
TOKEN_SECRET=change-me-to-a-long-random-string

# Secret for ticket QR tokens — must be different from TOKEN_SECRET
TICKET_SECRET=change-me-to-another-long-random-string

# NODE_ENV=production
